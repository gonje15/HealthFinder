# HealthFinder settings. Copy to .env and change as needed; every value is optional.
# EXPO_PUBLIC_ values are built into the web app and visible to users, so never put secrets here.

# Overpass servers, comma-separated, tried in order.
EXPO_PUBLIC_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Search radius on first load, in kilometres.
EXPO_PUBLIC_DEFAULT_RADIUS_KM=5

# Time allowed for each Overpass server before trying the next, in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=20000
